@inject NavigationManager Nav

@code {
    [Parameter, EditorRequired]
    public AuthenticationState Estado { get; set; } = default!;

    protected override void OnInitialized()
    {
        // Autenticado pero sin el rol necesario: no tiene sentido volver a pedirle la contraseña.
        if (Estado.User.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo("/acceso-denegado", replace: true);
            return;
        }

        // Anónimo: a la presentación, recordando a dónde quería ir.
        var destino = Uri.EscapeDataString(new Uri(Nav.Uri).PathAndQuery);

        // forceLoad es imprescindible: las páginas de acceso se renderizan de forma
        // estática y necesitan una petición HTTP real, no una navegación del circuito.
        Nav.NavigateTo($"/bienvenida?returnUrl={destino}", forceLoad: true);
    }
}