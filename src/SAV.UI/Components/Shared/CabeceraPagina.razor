@*
    Cabecera común a todas las páginas: identidad de la pantalla a la izquierda
    y acción principal a la derecha. Da coherencia inmediata a toda la aplicación.
*@

<header class="sav-cabecera">
    <div class="sav-cabecera__identidad">
        @if (Volver is not null)
        {
            <RadzenButton Icon="arrow_back" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                          class="sav-cabecera__volver" title="Volver" aria-label="Volver"
                          Click="@(() => Nav.NavigateTo(Volver))" />
        }
        <div>
            <h1 class="sav-cabecera__titulo">@Titulo</h1>
            @if (!string.IsNullOrWhiteSpace(Descripcion))
            {
                <p class="sav-cabecera__descripcion">@Descripcion</p>
            }
        </div>
    </div>

    @if (Acciones is not null)
    {
        <div class="sav-cabecera__acciones">
            @Acciones
        </div>
    }
</header>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;

    /// <summary>Una línea que explica qué se ve en la pantalla. Opcional pero recomendable.</summary>
    [Parameter] public string? Descripcion { get; set; }

    /// <summary>Ruta a la que vuelve la flecha. Si es null, no se muestra.</summary>
    [Parameter] public string? Volver { get; set; }

    [Parameter] public RenderFragment? Acciones { get; set; }
}
