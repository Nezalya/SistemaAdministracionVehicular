@page "/clientes"
@attribute [Authorize(Roles = Roles.AdminOVendedor)]

@using System.ComponentModel.DataAnnotations

@inject IClienteApi ClienteApi
@inject DialogService Dialogos
@inject AvisosUi Avisos

<PageTitle>Clientes — SAV</PageTitle>

<CabeceraPagina Titulo="Clientes"
                Descripcion="Personas que compran en el concesionario.">
    <Acciones>
        <RadzenButton Text="Nuevo cliente" Icon="person_add" Click="@(() => AbrirFormulario(null))" />
    </Acciones>
</CabeceraPagina>

<section class="sav-filtros" aria-label="Búsqueda de clientes">
    <div class="sav-filtro" style="flex:1 1 320px">
        <label class="sav-filtro__etiqueta" for="busqueda">Buscar</label>
        <RadzenTextBox Value="@busqueda" Name="busqueda" class="sav-input"
                       Placeholder="Nombre, NIF, correo o teléfono…"
                       ValueChanged="@((string v) => busqueda = v)" />
    </div>
    <div class="sav-filtros__acciones">
        <RadzenButton Text="Limpiar" Icon="clear" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base"
                      Click="@(() => busqueda = null)" Disabled="@string.IsNullOrWhiteSpace(busqueda)" />
    </div>
</section>

<EstadoDatos TDato="IReadOnlyList<ClienteDto>" Datos="Filtrados" Cargando="cargando" Error="@error"
             AlReintentar="CargarAsync"
             IconoVacio="groups"
             TituloVacio="@(string.IsNullOrWhiteSpace(busqueda) ? "Aún no hay clientes" : "Sin resultados")"
             TextoVacio="@(string.IsNullOrWhiteSpace(busqueda) ? "Da de alta el primer cliente para poder registrar ventas." : "Prueba con otro término de búsqueda.")">
    <AccionVacio>
        @if (string.IsNullOrWhiteSpace(busqueda))
        {
            <RadzenButton Text="Nuevo cliente" Icon="person_add" Click="@(() => AbrirFormulario(null))" />
        }
    </AccionVacio>

    <ChildContent>
        <div class="sav-tabla-scroll">
            <RadzenDataGrid TItem="ClienteDto" Data="@Filtrados" AllowPaging="true" PageSize="15"
                            AllowSorting="true" GridLines="DataGridGridLines.Horizontal"
                            ShowPagingSummary="true"
                            PagingSummaryFormat="{0} de {1} páginas · {2} clientes"
                            EmptyText="Sin clientes.">
                <Columns>
                    <RadzenDataGridColumn TItem="ClienteDto" Property="Nombre" Title="Nombre" Sortable="true" />
                    <RadzenDataGridColumn TItem="ClienteDto" Property="Nif" Title="NIF" Sortable="true"
                                          Width="140px" />
                    <RadzenDataGridColumn TItem="ClienteDto" Property="Telefono" Title="Teléfono"
                                          Sortable="false" Width="130px">
                        <Template Context="c">@Formato.OGuion(c.Telefono)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ClienteDto" Property="Email" Title="Correo" Sortable="false">
                        <Template Context="c">@Formato.OGuion(c.Email)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ClienteDto" Property="FechaRegistro" Title="Alta"
                                          Sortable="true" Width="110px">
                        <Template Context="c">@Formato.Fecha(c.FechaRegistro)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="ClienteDto" Title="" Sortable="false" Width="150px"
                                          TextAlign="TextAlign.End">
                        <Template Context="c">
                            <div class="sav-fila sav-fila--fin">
                                <RadzenButton Icon="receipt_long" Variant="Variant.Text"
                                              ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                              title="Resumen de compras" aria-label="Resumen de compras"
                                              Click="@(() => VerResumenAsync(c))" />
                                <RadzenButton Icon="edit" Variant="Variant.Text"
                                              ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                                              title="Editar" aria-label="Editar"
                                              Click="@(() => AbrirFormulario(c))" />
                                <RadzenButton Icon="delete" Variant="Variant.Text"
                                              ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small"
                                              title="Eliminar" aria-label="Eliminar"
                                              Click="@(() => EliminarAsync(c))" />
                            </div>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>
    </ChildContent>
</EstadoDatos>

@code {
    private IReadOnlyList<ClienteDto>? clientes;
    private bool cargando = true;
    private string? error;
    private string? busqueda;

    private IReadOnlyList<ClienteDto>? Filtrados
    {
        get
        {
            if (clientes is null) return null;
            if (string.IsNullOrWhiteSpace(busqueda)) return clientes;

            var t = busqueda.Trim();
            return clientes.Where(c =>
                    c.Nombre.Contains(t, StringComparison.OrdinalIgnoreCase)
                    || c.Nif.Contains(t, StringComparison.OrdinalIgnoreCase)
                    || (c.Email?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (c.Telefono?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        error = null;

        var resultado = await ClienteApi.ObtenerTodosAsync();

        if (resultado.Exito) clientes = resultado.Datos ?? [];
        else error = resultado.Mensaje;

        cargando = false;
    }

    private async Task AbrirFormulario(ClienteDto? cliente)
    {
        var parametros = new Dictionary<string, object?>
        {
            [nameof(ClienteFormulario.Cliente)] = cliente
        };

        var guardado = await Dialogos.OpenAsync<ClienteFormulario>(
            cliente is null ? "Nuevo cliente" : "Editar cliente",
            parametros!,
            new DialogOptions { Width = "560px", CloseDialogOnOverlayClick = false, ShowClose = true });

        if (guardado is true) await CargarAsync();
    }

    private async Task EliminarAsync(ClienteDto cliente)
    {
        var confirmado = await Confirmacion.EliminarAsync(
            Dialogos, $"al cliente {cliente.Nombre}",
            "No será posible si tiene ventas registradas.");

        if (!confirmado) return;

        var resultado = await ClienteApi.EliminarAsync(cliente.Id);

        if (resultado.Exito)
        {
            Avisos.Exito("Cliente eliminado.");
            await CargarAsync();
        }
        else
        {
            Avisos.ErrorDeApi(resultado, "eliminar el cliente");
        }
    }

    private async Task VerResumenAsync(ClienteDto cliente)
    {
        var resultado = await ClienteApi.ObtenerResumenComprasAsync(cliente.Id);

        if (resultado.Exito && resultado.Datos is not null)
        {
            var r = resultado.Datos;
            await Dialogos.Alert(
                $"{Formato.Numero(r.TotalCompras)} compras por un total de {Formato.Moneda(r.MontoTotal)}.",
                $"Compras de {r.ClienteNombre}",
                new AlertOptions { OkButtonText = "Cerrar", Width = "420px" });
        }
        else
        {
            // La API responde 400 cuando el cliente aún no tiene compras.
            await Dialogos.Alert(
                resultado.Mensaje ?? "Este cliente todavía no tiene compras registradas.",
                $"Compras de {cliente.Nombre}",
                new AlertOptions { OkButtonText = "Cerrar", Width = "420px" });
        }
    }
}
