@page "/Error"
@attribute [AllowAnonymous]
@layout EmptyLayout

@using System.Diagnostics

@inject NavigationManager Nav

<PageTitle>Error — SAV</PageTitle>

<PaginaMensaje Titulo="Se nos ha calado el motor"
               Descripcion="Ocurrió un error inesperado al procesar tu solicitud. Ya ha quedado registrado; puedes intentarlo de nuevo o volver al inicio.">
    <Detalle>
        @if (MostrarIdentificador)
        {
            @* Identificador de correlación: sirve para localizar el fallo en los
               registros del servidor. No contiene información sensible. *@
            <p class="sav-mensaje__referencia">
                Referencia del incidente
                <code>@RequestId</code>
            </p>
        }
    </Detalle>

    <Acciones>
        <RadzenButton Text="Reintentar" Icon="refresh"
                      Click="@(() => Nav.NavigateTo(Nav.Uri, forceLoad: true))" />
        <RadzenButton Text="Volver al inicio" Icon="home" Variant="Variant.Outlined"
                      ButtonStyle="ButtonStyle.Base"
                      Click="@(() => Nav.NavigateTo("/", forceLoad: true))" />
    </Acciones>
</PaginaMensaje>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool MostrarIdentificador => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
