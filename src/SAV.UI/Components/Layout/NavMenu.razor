@*
    Navegación por rol. Cada entrada se muestra solo a quien la API permite usarla,
    de modo que nadie llegue a una pantalla para recibir un 403.
*@

<nav class="sav-nav" aria-label="Navegación principal">
    <RadzenPanelMenu>

        <RadzenPanelMenuItem Text="Inicio" Icon="dashboard" Path="/" Match="NavLinkMatch.All" />

        <AuthorizeView Roles="@Roles.AdminOVendedor">
            <RadzenPanelMenuItem Text="Inventario" Icon="directions_car" Expanded="true">
                <RadzenPanelMenuItem Text="Automóviles" Icon="list" Path="/automoviles" />
                <RadzenPanelMenuItem Text="Resumen de stock" Icon="inventory_2" Path="/stock" />
                <AuthorizeView Roles="@Roles.Administrador" Context="soloAdmin">
                    <RadzenPanelMenuItem Text="Alta por lote" Icon="library_add" Path="/automoviles/lote" />
                </AuthorizeView>
            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Text="Catálogo" Icon="menu_book">
                <RadzenPanelMenuItem Text="Marcas" Icon="sell" Path="/marcas" />
                <RadzenPanelMenuItem Text="Modelos" Icon="category" Path="/modelos" />
                <RadzenPanelMenuItem Text="Características" Icon="tune" Path="/caracteristicas" />
                <AuthorizeView Roles="@Roles.Administrador" Context="soloAdmin">
                    <RadzenPanelMenuItem Text="Importar de fábrica" Icon="cloud_download" Path="/fabrica" />
                </AuthorizeView>
            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Text="Ventas" Icon="receipt_long">
                <RadzenPanelMenuItem Text="Listado" Icon="list_alt" Path="/ventas" />
                <RadzenPanelMenuItem Text="Nueva venta" Icon="add_shopping_cart" Path="/ventas/nueva" />
            </RadzenPanelMenuItem>

            <RadzenPanelMenuItem Text="Clientes" Icon="groups" Path="/clientes" />

            <RadzenPanelMenuItem Text="Red comercial" Icon="hub">
                <RadzenPanelMenuItem Text="Concesionario" Icon="store" Path="/concesionario" />
                <RadzenPanelMenuItem Text="Servicios oficiales" Icon="build" Path="/servicios-oficiales" />
                <AuthorizeView Roles="@Roles.Administrador" Context="soloAdmin">
                    <RadzenPanelMenuItem Text="Vendedores" Icon="badge" Path="/vendedores" />
                </AuthorizeView>
            </RadzenPanelMenuItem>
        </AuthorizeView>

        <AuthorizeView Roles="@Roles.Administrador">
            <RadzenPanelMenuItem Text="Seguridad" Icon="admin_panel_settings">
                <RadzenPanelMenuItem Text="Usuarios" Icon="manage_accounts" Path="/usuarios" />
                <RadzenPanelMenuItem Text="Registrar usuario" Icon="person_add" Path="/usuarios/nuevo" />
            </RadzenPanelMenuItem>
        </AuthorizeView>

    </RadzenPanelMenu>
</nav>
