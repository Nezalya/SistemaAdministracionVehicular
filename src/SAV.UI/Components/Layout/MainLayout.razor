@inherits LayoutComponentBase

@* Aloja los diálogos, notificaciones y tooltips de Radzen. Debe estar una sola vez. *@
<RadzenComponents />

<RadzenLayout>
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal"
                     AlignItems="AlignItems.Center"
                     Gap="0.5rem" class="rz-px-3 rz-py-2">
            <RadzenSidebarToggle Click="@(() => barraLateralAbierta = !barraLateralAbierta)" />
            <RadzenIcon Icon="directions_car" />
            <RadzenText TextStyle="TextStyle.H6" class="rz-my-0">SAV</RadzenText>

            <RadzenStack Orientation="Orientation.Horizontal"
                         AlignItems="AlignItems.Center"
                         Gap="0.25rem" class="rz-ml-auto">
                <RadzenAppearanceToggle />
                <UserMenu />
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>

    <RadzenSidebar @bind-Expanded="barraLateralAbierta" Responsive="true">
        <NavMenu />
    </RadzenSidebar>

    <RadzenBody>
        <div class="rz-p-4">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

<div id="blazor-error-ui" data-nosnippet>
    Se produjo un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool barraLateralAbierta = true;
}